{
  "name": "macversus",
  "version": "0.1.0",
  "private": true,
  "description": "Compare MacBooks com benchmarks reais, condições de teste e fontes.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:preview": "node scripts/build-preview.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "esbuild": "0.28.2"
  }
}
